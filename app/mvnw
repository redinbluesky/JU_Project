#!/bin/sh
# Maven Wrapper script - simplified

APP_HOME=$(cd "$(dirname "$0")" && pwd)

# Use Maven from extracted archive
MAVEN_HOME="$APP_HOME/../Temp/apache-maven-3.9.9"

if [ ! -d "$MAVEN_HOME" ]; then
  echo "Maven not found at $MAVEN_HOME"
  exit 1
fi

# Execute Maven
exec java \
  -Dmaven.home="$MAVEN_HOME" \
  -Dmaven.multiModuleProjectDirectory="$APP_HOME" \
  -cp "$MAVEN_HOME/lib/maven-embedder-3.9.9.jar:$MAVEN_HOME/lib/maven-core-3.9.9.jar:$MAVEN_HOME/boot/plexus-classworlds-2.8.0.jar" \
  org.apache.maven.cli.Main "$@"
